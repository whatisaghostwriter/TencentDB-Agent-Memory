# TDAI 全局影像本地部署 — docker-compose 环境变量模板
#
# 用法：
#   cd deploy/compose
#   cp .env.example .env
#   # 编辑 .env，把 REPLACE_ME 换成真值
#   docker compose up -d
#
# 停止/清理：
#   docker compose down            # 停容器，保留 volume（数据保留）
#   docker compose down -v         # 停容器 + 删 volume + 网络（彻底清理）
#   docker compose up -d --force-recreate   # 编辑 .env 后重新渲染并重启
#
# 三组服务镜像默认走 Docker Hub 公开镜像（多架构 amd64 + arm64，无需登录）：
#   agentmemory/memory-core   :8420   (记忆网关)
#   agentmemory/memory-hub    :8125 面板 + :8424 知识   (内存控件)
#   agentmemory/memory-proxy  :8096   (上下文代理)
# 想固定版本把 :latest 换成具体版本，例如 :1.0.0-beta.1。
#
# 镜像 tag（可选）
MEMORY_CORE_IMAGE=agentmemory/memory-core:latest
MEMORY_HUB_IMAGE=agentmemory/memory-hub:latest
PROXY_IMAGE=agentmemory/memory-proxy:latest

# ── memory 组：memory + memory-hub 内部调用的 LLM ────────────────────────────
# 用途：memory 的 embed/总结；memory-hub 里 knowledge 的 wiki ingest / 总结
MEMORY_LLM_BASE_URL=REPLACE_ME              # 例：https://api.deepseek.com/v1
MEMORY_LLM_API_KEY=REPLACE_ME               # 例：sk-xxxxxxxx
MEMORY_LLM_MODEL=REPLACE_ME                 # 例：deepseek-chat
MEMORY_LLM_PROTOCOL=openai                  # openai | anthropic
MEMORY_LLM_MAX_TOKENS=32000
MEMORY_LLM_TIMEOUT_MS=300000
# memory L1/L2/L3 抽提 prompt 族：chat（默认）| code
MEMORY_PROMPT_MODE=chat

# ── proxy 组：proxy 把用户请求转发到的上游 LLM ────────────────────────────────
# 用途：coding agent / 客户端调 proxy:8096，proxy 再转发到这里
PROXY_UPSTREAM_URL=REPLACE_ME               # 例：https://api.deepseek.com/v1
PROXY_UPSTREAM_API_KEY=REPLACE_ME           # 例：sk-xxxxxxxx（可与 memory 组不同）
PROXY_UPSTREAM_MODEL=REPLACE_ME             # 例：deepseek-chat（仅用于使用提示）
PROXY_LOG_LEVEL=info                        # trace|debug|info|warn|error

# ── 端口（默认可直接用；本地冲突时改） ───────────────────────────────────────
MEMORY_CORE_PORT=8420
PANEL_PORT=8125
KNOWLEDGE_PORT=8424
PROXY_PORT=8096

# ── memory-core 内部网关凭据 ───────────────────────────────────────────────────
# 留空（默认）   — 关闭 Bearer gate，本地零配置体验；proxy 的 auth/sessionInit
#                会委托 memory-core /v3/meta/auth/verify 校验 x-tdai-user-key。
# 非空          — 所有请求需带 Authorization: Bearer <key>。
#   ⚠️ 已知：proxy 的 auth/sessionInit 调用目前不带 Bearer 头，故启用时会失败。
#   本地体验请把本项留空。
MEMORY_CORE_GATEWAY_API_KEY=

# ── memory-core 管理员 user_key ────────────────────────────────────────────────
# 首次启动时 init-admin 会用这个值创建系统管理员用户。后续重启 409（已存在）
# 会被忽略，故该值固定在此即可幂等 —— 也是客户端 (Claude Code 等) 透过 proxy
# 时随 `x-tdai-user-key` 头传入的值。
MEMORY_CORE_ADMIN_USERNAME=admin
MEMORY_CORE_ADMIN_USER_KEY=sk-mem-change-me-please-0123456789

# ── 数据卷名 ───────────────────────────────────────────────────────────────────
# 数据卷由 compose 管理（固定名），无需自行配置。彻底清理时用 `docker compose down -v`。

# ── proxy 能力开关（默认全开，等同于原 install 脚本的 PROXY_FULL_STACK=1）───────
# 关闭任意一项会降级对应的能力：
#   PROXY_ENABLE_AUTH            : 校验 x-tdai-user-key → memory-core /auth/verify
#   PROXY_ENABLE_TDAI            : L2/L3 记忆注入 + L1 召回（依赖 memory-core）
#   PROXY_ENABLE_SESSION_INIT    : 首轮弹表单选 team/agent/task（依赖 auth+tdai）
#   PROXY_ENABLE_REDIS           : proxy 外部状态后端（Redis），关闭则进程内 SQLite
PROXY_ENABLE_TDAI=true
PROXY_ENABLE_AUTH=true
PROXY_ENABLE_SESSION_INIT=true
PROXY_ENABLE_REDIS=false

# ── knowledge 外部可达地址 ─────────────────────────────────────────────────────
# 让 agent / 网关能访问到 KS 的 tools 接口（需含 /v3 前缀）。
# 留空则自动派派：http://host.docker.internal:<KNOWLEDGE_PORT>/v3
# （内存控件容器内通过 --add-host=host.docker.internal:host-gateway 回环到宿主）。
#KNOWLEDGE_PUBLIC_BASE_URL=http://host.docker.internal:8424/v3

# ── Panel UI "客户端接入地址" 卡片显示的 base URL ──────────────────────────────
# coding agent 客户端要接的 proxy 地址（用于复制 Panel 上的卡片）。
# 留空则自动派派：http://127.0.0.1:<PROXY_PORT>（本地同机使用）。
# 跨机/公网请填实际地址，例如 http://192.168.1.100:8096。
#PROXY_PUBLIC_URL=http://127.0.0.1:8096
